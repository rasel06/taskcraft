# DATABASE_URL="file:./dev.db"

DATABASE_URL="postgresql://taskcraft:taskcraft@localhost:5484/task_craft_db"

# Used only by docker-compose (the `postgres` service's own credentials, and
# to build DATABASE_URL for the containerized app). Not read by `npm run dev`
# on the host - that uses DATABASE_URL above instead. Change these before
# deploying anywhere that isn't your own machine.
POSTGRES_USER="taskcraft"
POSTGRES_PASSWORD="taskcraft"
POSTGRES_DB="task_craft_db"


# App base URL used to build links inside notification messages.
APP_URL="http://localhost:3000"

# Telegram bot (optional). Create a bot via @BotFather to get a token,
# then run `npm run telegram:bot` alongside `npm run dev`.
TELEGRAM_BOT_TOKEN="8693708689:AAEE1u65trXw-U5Smz_eHPZwkfV_RqcnsBY"
TELEGRAM_BOT_USERNAME="JBCoreCbsBot"

