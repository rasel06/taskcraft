
services:

  taskcraft_pg:
    # <-- Change this from "postgres" to "taskcraft_pg"
    image: postgres:16
    container_name: task_craft_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-taskcraft}
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}"
      POSTGRES_DB: ${POSTGRES_DB:-task_craft_db}
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "5484:5432"
    networks:
      - finx-network

  taskcraft:
    container_name: taskcraft
    image: 172.18.18.66:4040/imran/taskcraft:v1
    pull_policy: always
    restart: unless-stopped
    networks:
      - finx-network
    ports:
      - "3000:3000"
    env_file:
      - .env
    environment:
      - NODE_ENV=production
      # Overrides the DATABASE_URL from .env (which points at localhost, for
      # `npm run dev` on the host) so the containerized app talks to the
      # `postgres` service below instead.
      - DATABASE_URL=postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@postgres:5432/${POSTGRES_DB:-task_craft_db}
    depends_on:
      postgres:
        condition: service_healthy
  # postgres:
  #   container_name: taskcraft-postgres
  #   image: postgres:16-alpine
  #   restart: unless-stopped
  #   networks:
  #     - finx-network
  #   environment:
  #     - POSTGRES_USER=${POSTGRES_USER:-postgres}
  #     - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-postgres}
  #     - POSTGRES_DB=${POSTGRES_DB:-task_craft_db}
  #   volumes:
  #     - taskcraft_postgres_data:/var/lib/postgresql/data
  #   healthcheck:
  #     test: [ "CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-task_craft_db}" ]
  #     interval: 5s
  #     timeout: 5s
  #     retries: 5

volumes:
  taskcraft_postgres_data:
    name: taskcraft_postgres_data

networks:
  finx-network:
    external: true
